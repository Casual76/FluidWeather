<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!--
      MapLibre (il radar) dichiara anche lo stato del Wi-Fi, un'eredita' della telemetria che non
      c'e' piu': il suo codice non lo legge (verificato nella 13.7.1), e l'app non lo chiede.
  -->
  <uses-permission
      android:name="android.permission.ACCESS_WIFI_STATE"
      tools:node="remove" />

  <application
      android:name=".FluidWeatherApp"
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.FluidWeather">
    <!--
        launchMode="singleTask" e' cio' che impedisce la seconda home.

        Il widget lancia un ACTION_VIEW con un uri (i bersagli si distinguono per Uri, non per
        extra), e Glance ci aggiunge FLAG_ACTIVITY_NEW_TASK. Con il launchMode di default il
        sistema riusa il task ma **impila una seconda MainActivity**, perche' quell'intent non
        combacia con l'intent di radice (ACTION_MAIN/CATEGORY_LAUNCHER): due setContent, due
        NavHost, due home, e il tasto indietro che scopre quella di prima.

        singleTask e non singleTop: singleTop riusa l'istanza solo se e' gia' IN CIMA, e con l'app
        aperta su Radar o Impostazioni non lo e'. Da qui in poi il secondo tocco arriva a
        onNewIntent, che era gia' scritto e non poteva essere chiamato.
    -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:theme="@style/Theme.FluidWeather">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!--
        Gli strumenti del meteo per PampAI/Aria: permesso `signature`, quindi li chiama solo un'app
        firmata con la stessa chiave. L'authority segue l'applicationId (la debug ha la sua).
    -->
    <provider
        android:name=".pampai.WeatherToolHostProvider"
        android:authorities="${applicationId}.ai.tools"
        android:exported="true"
        android:permission="dev.antigravity.fluidengine.permission.AI_TOOLS">
      <meta-data
          android:name="dev.antigravity.fluidengine.ai.TOOL_HOST"
          android:value="1" />
    </provider>
  </application>

</manifest>
