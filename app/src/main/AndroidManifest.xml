<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
      android:name=".FluidWeatherApp"
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.FluidWeather">
    <!-- Google Maps SDK (radar): la chiave arriva da local.properties via manifestPlaceholders. -->
    <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="${mapsApiKey}" />
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:theme="@style/Theme.FluidWeather">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!--
        Gli strumenti del meteo per PampAI/Aria: permesso `signature`, quindi li chiama solo un'app
        firmata con la stessa chiave. L'authority segue l'applicationId (la debug ha la sua).
    -->
    <provider
        android:name=".pampai.WeatherToolHostProvider"
        android:authorities="${applicationId}.ai.tools"
        android:exported="true"
        android:permission="dev.antigravity.fluidengine.permission.AI_TOOLS">
      <meta-data
          android:name="dev.antigravity.fluidengine.ai.TOOL_HOST"
          android:value="1" />
    </provider>
  </application>

</manifest>
